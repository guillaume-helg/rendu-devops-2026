meta {
  name: Complete Flow - Register, Create Client, Account, Operations
  type: http
  seq: 25
}

post {
  url: {{base_url}}/api/v1/auth/register
}

body:json {
  {
    "firstname": "Integration",
    "lastname": "Test",
    "email": "integration@test.com",
    "password": "test123"
  }
}

tests {
  test("Status code is 200 or 201", function() {
    expect([200, 201]).to.include(res.getStatus());
  });
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setEnvVar("auth_token", res.body.access_token);
    bru.setEnvVar("refresh_token", res.body.refresh_token);
  }
}