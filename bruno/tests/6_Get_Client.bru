meta {
  name: Get Client By ID
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/clients/{{client_id}}
}

headers {
  Authorization: Bearer {{auth_token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response contains client ID", function() {
    expect(res.body).to.have.property("id");
  });

  test("Response contains nom", function() {
    expect(res.body).to.have.property("nom");
  });

  test("Response contains prenom", function() {
    expect(res.body).to.have.property("prenom");
  });
}